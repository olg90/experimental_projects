from scipy.stats import ttest_ind

# =====================================
# T-TEST: 20 Hz vs 100 Hz
# for each cell and Ca condition
# =====================================

alpha = 0.01

results = []

for cell in range(len(data3)):

    # FIRST QC ONLY (same as your plots)
    low_20 = np.asarray(data3[cell][0], dtype=float)[0, :]
    low_100 = np.asarray(data3[cell][1], dtype=float)[0, :]

    high_20 = np.asarray(data3[cell][2], dtype=float)[0, :]
    high_100 = np.asarray(data3[cell][3], dtype=float)[0, :]

    # -----------------------------
    # LOW Ca: 20 vs 100 Hz
    # -----------------------------
    t_low, p_low = ttest_ind(low_20, low_100, equal_var=False, nan_policy='omit')

    # -----------------------------
    # HIGH Ca: 20 vs 100 Hz
    # -----------------------------
    t_high, p_high = ttest_ind(high_20, high_100, equal_var=False, nan_policy='omit')

    results.append({
        "cell": cell_names[cell],

        "low_t": t_low,
        "low_p": p_low,
        "low_sig": p_low < alpha,

        "high_t": t_high,
        "high_p": p_high,
        "high_sig": p_high < alpha
    })

# =====================================
# PRINT RESULTS
# =====================================
