def p_dynamic(i,prefill,prefill_min,thr,hill):
    return prefill_min+(prefill-prefill_min)/(1+(i/thr)**hill)

def p_constant(i,prefill):
    return prefill

def update_pool_probability(p_previous,pr,refill):
    return p_previous*(1-pr)+(1-p_previous*(1-pr))*refill

model_config={
    1:{"npools":1},
