def p_dynamic(i, prefill, prefill_min, thr, hill):
    # prefill is the maximum; prefill_min is the asymptotic minimum.
    # The resulting refill probability cannot increase with i.
    return prefill_min + (prefill - prefill_min) / (
        1 + (i / thr) ** hill
    )

def update_pool_probability(p_previous, pr, refill):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * refill

def model(params):
    npools = len(params["M"])
    pool_probability = []
    pool_mqc = []

    for j in range(npools):
        p = np.ones(nstim)

        for i in range(1, nstim):
            refill = p_dynamic(
                i - 1,
                params["prefill"][j],
                params["prefill_min"][j],
                params["thr"][j],
                params["hill"][j]
            )

            p[i] = update_pool_probability(
                p[i - 1],
                params["pr"][j],
                refill
            )

        pool_probability.append(p)
        pool_mqc.append(params["M"][j] * p * params["pr"][j])

    mqc = np.sum(pool_mqc, axis=0)

    vqc = np.sum([
        M * p * pr * (1 - p * pr)
        for M, p, pr in zip(
            params["M"], pool_probability, params["pr"]
        )
    ], axis=0)

    vei = mqc * CVq**2 + vqc
    CV2 = vei / (mqc**2)
    FF = vei / mqc

    return {
        "mqc": mqc,
        "CV2": CV2,
        "FF": FF,
        "pool_mqc": pool_mqc,
        "pool_probability": pool_probability
    }

