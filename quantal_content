            index += 1

    return params

def mle(x, npools):
    params = unpack_params(x, npools)

    if params["M"][0] <= 0:
        return penalty

    if np.any(np.asarray(params["pr"]) <= 0):
        return penalty

    # Enforce decreasing replenishment probability in pools 1 and 3+.
    for j in range(npools):
        if j != 1:
            if params["pd_min"][j] >= params["pd_max"][j]:
                return penalty

    result = model(params)
    mqc = result["mqc"]
    CV2 = result["CV2"]

    if np.any(mqc <= 0) or np.any(CV2 <= 0):
        return penalty

    shape = 1 / CV2
    scale = mqc * CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return penalty

    loglik = gamma.logpdf(
        obs,
        a=shape[:, None],
        scale=scale[:, None]
    )

    if np.any(~np.isfinite(loglik)):
        return penalty

    return -np.sum(loglik)

