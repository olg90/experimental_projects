def model(params):

    npools=len(params["M"])

    pool_probability=[]
    pool_mqc=[]

    for j in range(npools):

        p=np.ones(nstim)

        for i in range(1,nstim):

            if j==1:
                refill=p_constant(
                    i-1,
                    params["prefill"][j]
                )

            else:
                refill=p_dynamic(
                    i-1,
                    params["prefill"][j],
                    params["prefill_min"][j],
                    params["thr"][j],
                    params["hill"][j]
                )

            p[i]=update_pool_probability(
                p[i-1],
                params["pr"][j],
                refill
            )

        pool_probability.append(p)

        pool_mqc.append(
            params["M"][j]*p*params["pr"][j]
        )

    mqc=np.sum(pool_mqc,axis=0)

    vqc=np.sum(
        [
            M*p*pr*(1-p*pr)
            for M,p,pr in zip(
                params["M"],
                pool_probability,
                params["pr"]
            )
        ],
        axis=0
    )

    vei=mqc*CVq**2+vqc

    CV2=vei/(mqc**2)
    FF=vei/mqc

    return {
        "mqc":mqc,
        "CV2":CV2,
        "FF":FF,
        "pool_mqc":pool_mqc,
        "pool_probability":pool_probability
    }

def create_param_names(npools):

    names=[]

    # Independent pr for every pool
    for i in range(npools):
        names.append(f'pr{i+1}')

    # M2, M3, ...
    for i in range(2,npools+1):
        names.append(f'M{i}')

    for i in range(npools):
        names.append(f'hill{i+1}')

    for i in range(npools):
        names.append(f'thr{i+1}')

    for i in range(npools):
        names.append(f'prefill{i+1}')

    for i in range(npools):
        names.append(f'prefillmin{i+1}')

    return names

def create_bounds(npools):

    bounds=[]

    # Independent pr for every pool
    for i in range(npools):
        bounds.append(bounds_pool["pr"])

    # M2, M3, ...
    for i in range(1,npools):
        bounds.append(bounds_pool["M"])

    for i in range(npools):
        bounds.append(bounds_pool["hill"])

    for i in range(npools):
        bounds.append(bounds_pool["thr"])

    for i in range(npools):
        bounds.append(bounds_pool["prefill"])

    for i in range(npools):
        bounds.append(bounds_pool["prefill_min"])

    return bounds

def unpack_params(x,npools):

    params={}

    index=0

    # Independent pr for each pool
    params["pr"]=list(x[index:index+npools])
    index+=npools

    # M2, M3, ...
    M=[0]*npools

    for i in range(1,npools):
        M[i]=int(round(x[index]))
        index+=1

    # At the first AP, p=1 for every pool:
    #
    # mean_data[0] = M1*pr1 + M2*pr2 + ... + MN*prN
    #
    # Therefore:
    #
    # M1 = (mean_data[0] - sum(Mj*prj, j>1)) / pr1

    other_mqc=np.sum(
        [
            M[j]*params["pr"][j]
            for j in range(1,npools)
        ]
    )

    M[0]=int(round(
        (mean_data[0]-other_mqc)/params["pr"][0]
    ))

    params["M"]=M

    params["hill"]=list(x[index:index+npools])
    index+=npools

    params["thr"]=list(x[index:index+npools])
    index+=npools

    params["prefill"]=list(x[index:index+npools])
    index+=npools

    params["prefill_min"]=list(x[index:index+npools])

    return params

def mle(x,npools):

    params=unpack_params(x,npools)

    # M1 must be positive
    if params["M"][0]<=0:
        return np.inf

    # Refilling probability must not increase:
    # prefill_min < prefill for every pool
    if np.any(
        np.asarray(params["prefill_min"]) >=
        np.asarray(params["prefill"])
    ):
        return np.inf

    result=model(params)

    mqc=result["mqc"]
    CV2=result["CV2"]

    if np.any(mqc<=0) or np.any(CV2<=0):
        return np.inf

    shape=1/CV2
    scale=mqc*CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return np.inf

    loglik=gamma.logpdf(
        obs,
        a=shape[:,None],
        scale=scale[:,None]
    )

    if np.any(~np.isfinite(loglik)):
        return np.inf

    return -np.sum(loglik)

def opt(npools):

    bounds=create_bounds(npools)
    names=create_param_names(npools)

    result=differential_evolution(
        lambda x:mle(x,npools),
        bounds,
        maxiter=1000,
        popsize=20,
        tol=1e-9,
        polish=True,
        workers=1,
        updating='immediate'
    )

    params=unpack_params(result.x,npools)

    AIC=2*len(bounds)+2*result.fun

    print(f'{npools} pool model')

    for name,value in zip(names,result.x):
        print(f'{name}={value}')

    print(f'M1={params["M"][0]}')
    print(f'M={params["M"]}')
    print(f'AIC={AIC}')

    return {
        "params":params,
        "result":result,
        "AIC":AIC,
        "model":model(params)
    }

