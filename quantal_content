def p1d(i,prefill1,prefillmin,thr,hill):
    return prefillmin+(prefill1-prefillmin)/(1+(i/thr)**hill)

def p2d(i,prefill2):
    return prefill2

def p3d(i,prefill3,prefillmin3,thr3,hill3):
    return prefillmin3+(prefill3-prefillmin3)/(1+(i/thr3)**hill3)

def p4d(i,prefill3,prefillmin3,thr3,hill3):
    return prefillmin3+(prefill3-prefillmin3)/(1+(i/thr3)**hill3)

def p5d(i,prefill3,prefillmin3,thr3,hill3):
    return prefillmin3+(prefill3-prefillmin3)/(1+(i/thr3)**hill3)

def model(pr1,pr2,pr3,pr4,pr5,
          M2,M3,M4,M5,
          hill,hill3,hill4,hill5,
          thr,thr3,thr4,thr5,
          prefill1,prefill2,prefill3,prefill4,prefill5,
          prefillmin,prefillmin3,prefillmin4,prefillmin5):
