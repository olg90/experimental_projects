# =============================================================================
# Unpack optimized parameters
# =============================================================================

def unpack_params(x, npools, test_type):

    params = {}
    index = 0

    # -------------------------------------------------------------------------
    # Pool sizes
    # -------------------------------------------------------------------------

    M = [0] * npools

    for i in range(1, npools):
        M[i] = int(round(x[index]))
        index += 1

    # -------------------------------------------------------------------------
    # Increasing pr, fixed pd
    # -------------------------------------------------------------------------

    if test_type == 'increasing_pr_fixed_pd':

        params["pr_min"] = x[index]
        index += 1

        params["pr_max"] = list(x[index:index + npools])
        index += npools

        params["hill"] = list(x[index:index + npools])
        index += npools

        params["thr"] = list(x[index:index + npools])
        index += npools

        params["pd"] = list(x[index:index + npools])

        M[0] = int(round(
            mean_data[0] / params["pr_min"] - np.sum(M[1:])
        ))

    # -------------------------------------------------------------------------
    # Increasing pr1 and pr3+, fixed pr2, fixed pd
    # -------------------------------------------------------------------------

    elif test_type == 'increasing_pr2_fixed_pd':

        params["pr_min"] = x[index]
        index += 1

        params["pr_max"] = [None] * npools
        params["pr2"] = None

        for i in range(npools):
            if i == 1:
                params["pr2"] = x[index]
            else:
                params["pr_max"][i] = x[index]
            index += 1

        params["hill"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["hill"][i] = x[index]
                index += 1

        params["thr"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["thr"][i] = x[index]
                index += 1

        params["pd"] = list(x[index:index + npools])

        # At stimulus 1, pools 1 and 3+ have pr_min.
        # Pool 2 has the independently fitted constant pr2.
        other_M = np.sum([
            M[j] * (
                params["pr2"] if j == 1
                else params["pr_min"]
            )
            for j in range(1, npools)
        ])

        M[0] = int(round(
            (mean_data[0] - other_M) / params["pr_min"]
        ))

    # -------------------------------------------------------------------------
    # Fixed pr, decreasing pd
    # -------------------------------------------------------------------------

    elif test_type == 'fixed_pr_decreasing_pd':

        params["pr"] = list(x[index:index + npools])
        index += npools

        params["pd_max"] = list(x[index:index + npools])
        index += npools

        params["pd_min"] = list(x[index:index + npools])
        index += npools

        params["hill"] = list(x[index:index + npools])
        index += npools

        params["thr"] = list(x[index:index + npools])

        other_M = np.sum([
            M[j] * params["pr"][j]
            for j in range(1, npools)
        ])

        M[0] = int(round(
            (mean_data[0] - other_M) / params["pr"][0]
        ))

    # -------------------------------------------------------------------------
    # Fixed pr, decreasing pd1 and pd3+, fixed pd2
    # -------------------------------------------------------------------------

    elif test_type == 'fixed_pr_decreasing_pd2_fixed':

        params["pr"] = list(x[index:index + npools])
        index += npools

        params["pd2"] = None

        if npools >= 2:
            params["pd2"] = x[index]
            index += 1

        params["pd_max"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["pd_max"][i] = x[index]
                index += 1

        params["pd_min"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["pd_min"][i] = x[index]
                index += 1

        params["hill"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["hill"][i] = x[index]
                index += 1

        params["thr"] = [None] * npools

        for i in range(npools):
            if i != 1:
                params["thr"][i] = x[index]
                index += 1

        other_M = np.sum([
            M[j] * params["pr"][j]
            for j in range(1, npools)
        ])

        M[0] = int(round(
            (mean_data[0] - other_M) / params["pr"][0]
        ))

    params["M"] = M

    return params

# =============================================================================
# Maximum likelihood estimation
# =============================================================================

def mle(x, npools, test_type):

    params = unpack_params(x, npools, test_type)

    if params["M"][0] <= 0:
        return penalty if test_type == 'fixed_pr_decreasing_pd2_fixed' else np.inf

    # Enforce increasing release probability.
    if test_type == 'increasing_pr_fixed_pd':
        if np.any(
            np.asarray(params["pr_max"]) < params["pr_min"]
        ):
            return np.inf

    elif test_type == 'increasing_pr2_fixed_pd':
        for j in range(npools):
            if j != 1 and params["pr_max"][j] < params["pr_min"]:
                return np.inf

    # Enforce decreasing replenishment probability.
    elif test_type == 'fixed_pr_decreasing_pd':
        if np.any(
            np.asarray(params["pd_min"]) >=
            np.asarray(params["pd_max"])
        ):
            return np.inf

    elif test_type == 'fixed_pr_decreasing_pd2_fixed':
        for j in range(npools):
            if j != 1:
                if params["pd_min"][j] >= params["pd_max"][j]:
                    return penalty

    result = model(params, test_type)

    mqc = result["mqc"]
    CV2 = result["CV2"]

    if np.any(mqc <= 0) or np.any(CV2 <= 0):
        return penalty if test_type == 'fixed_pr_decreasing_pd2_fixed' else np.inf

    shape = 1 / CV2
    scale = mqc * CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return penalty if test_type == 'fixed_pr_decreasing_pd2_fixed' else np.inf

    loglik = gamma.logpdf(
        obs,
        a=shape[:, None],
        scale=scale[:, None]
    )

    if np.any(~np.isfinite(loglik)):
        return penalty if test_type == 'fixed_pr_decreasing_pd2_fixed' else np.inf

    return -np.sum(loglik)

# =============================================================================
# Optimize 1-4 pool models for one test
# =============================================================================

def opt(npools, test_type):

    bounds = create_bounds(npools, test_type)
    names = create_param_names(npools, test_type)

    result = differential_evolution(
        lambda x: mle(x, npools, test_type),
        bounds,
        maxiter=maxiter,
        popsize=popsize,
        tol=tol,
        polish=True,
        workers=1,
        updating='immediate'
    )

    params = unpack_params(result.x, npools, test_type)
    AIC = 2 * len(bounds) + 2 * result.fun

    print(f'\n{test_type}: {npools} pool model')

    for name, value in zip(names, result.x):
        print(f'{name}={value}')

    print(f'M1={params["M"][0]}')
    print(f'M={params["M"]}')
    print(f'AIC={AIC}')

    return {
        "params": params,
        "result": result,
        "AIC": AIC,
        "model": model(params, test_type)
    }

