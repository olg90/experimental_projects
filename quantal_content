def p_dynamic(i,prefill,prefill_min,thr,hill):
    return prefill_min+(prefill-prefill_min)/(1+(i/thr)**hill)
def p_constant(i,prefill):
    return prefill
def update_pool_probability(p_previous,pr,refill):
    return p_previous*(1-pr)+(1-p_previous*(1-pr))*refill
model_config={
    1:{"npools":1},
    2:{"npools":2},
    3:{"npools":3},
    4:{"npools":4},
}
def model(params):
    npools=len(params["M"])
    pool_probability=[]
    pool_mqc=[]
    for j in range(npools):
        p=np.ones(nstim)
        for i in range(1,nstim):
            if j==1:
                refill=p_constant(
                    i-1,
                    params["prefill"][j]
                )
            else:
                refill=p_dynamic(
                    i-1,
                    params["prefill"][j],
                    params["prefill_min"][j],
                    params["thr"][j],
                    params["hill"][j]
                )
            p[i]=update_pool_probability(
                p[i-1],
                params["pr"][j],
                refill
            )
        pool_probability.append(p)
        pool_mqc.append(
            params["M"][j]*p*params["pr"][j]
        )
    mqc=np.sum(pool_mqc,axis=0)
    vqc=np.sum(
        [
            M*p*pr*(1-p*pr)
            for M,p,pr in zip(
                params["M"],
                pool_probability,
                params["pr"]
            )
        ],
        axis=0
    )
    vei=mqc*CVq**2+vqc
    CV2=vei/(mqc**2)
    FF=vei/mqc
    return {
        "mqc":mqc,
        "CV2":CV2,
        "FF":FF,
        "pool_mqc":pool_mqc,
        "pool_probability":pool_probability
    }
