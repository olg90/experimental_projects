def p3d(i,prefill3,prefillmin3,thr3,hill3):
    return prefillmin3+(prefill3-prefillmin3)/(1+(i/thr3)**hill3)

def simulate(n1init, n2init, n3init, pr1, pr2, pr3, p1d, p2d, p3d, M1, M2, M3, nstim, navgs):
    bmeanlist=[]
    for _ in range(navgs):
        blist=[]
        n1=n1init
        n2=n2init
        n3=n3init
        for i in range(nstim):
            if i!=0:
                n1+=binomial(M1-n1, p1d(i,prefill1,prefillmin,thr,hill))
                n2+=binomial(M2-n2, p2d(i,prefill2))
                n3+=binomial(M3-n3, p3d(i,prefill3,prefillmin3,thr3,hill3))
            b1=binomial(n1,pr1)
            b2=binomial(n2,pr2)
            b3=binomial(n3,pr3)
            n1-=b1
            n2-=b2
            n3-=b3
            b=b1+b2+b3
            blist.append(b)
        bmeanlist.append(blist)
    minlen=np.min([len(b) for b in bmeanlist])
    bmeanlist2=np.array([x[:minlen] for x in bmeanlist])
    ff=np.var(bmeanlist2, axis=0)/np.mean(bmeanlist2, axis=0)
    bmean=np.mean(bmeanlist2, axis=0)
    return bmean,ff

