    "pr_max": (0.01, 1),
    "M": (0, 100),
    "hill": (0.01, 10),
    "thr": (0.01, 100),
    "pd": (0, 1)
}

def pr_dynamic(i, pr_min, pr_max, thr, hill):
    # Release probability increases from pr_min toward pr_max.
    return pr_min + (pr_max - pr_min) * (
        i**hill / (thr**hill + i**hill)
    )

def update_pool_probability(p_previous, pr, pd):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * pd

def model(params):
    npools = len(params["M"])
    pool_probability = []
    pool_pr = []
    pool_mqc = []

    for j in range(npools):
        pr = pr_dynamic(
            np.arange(nstim),
            params["pr_min"],
            params["pr_max"][j],
            params["thr"][j],
            params["hill"][j]
        )

        p = np.ones(nstim)

        for i in range(1, nstim):
            p[i] = update_pool_probability(
                p[i - 1],
                pr[i - 1],
                params["pd"][j]
            )

        pool_probability.append(p)
        pool_pr.append(pr)
        pool_mqc.append(params["M"][j] * p * pr)

    mqc = np.sum(pool_mqc, axis=0)

    vqc = np.sum([
        M * p * pr * (1 - p * pr)
        for M, p, pr in zip(
            params["M"], pool_probability, pool_pr
        )
    ], axis=0)

    vei = mqc * CVq**2 + vqc
    CV2 = vei / (mqc**2)
    FF = vei / mqc

    return {
        "mqc": mqc,
        "CV2": CV2,
        "FF": FF,
        "pool_mqc": pool_mqc,
        "pool_probability": pool_probability,
        "pool_pr": pool_pr
    }

def create_param_names(npools):
    names = ['pr_min']

    for i in range(2, npools + 1):
        names.append(f'M{i}')

    for i in range(npools):
        names.append(f'pr_max{i+1}')

    for i in range(npools):
        names.append(f'hill{i+1}')

    for i in range(npools):
        names.append(f'thr{i+1}')

    for i in range(npools):
        names.append(f'pd{i+1}')

    return names

def create_bounds(npools):
    bounds = [bounds_pool["pr_min"]]

    for i in range(1, npools):
        bounds.append(bounds_pool["M"])

    for i in range(npools):
        bounds.append(bounds_pool["pr_max"])

    for i in range(npools):
        bounds.append(bounds_pool["hill"])

    for i in range(npools):
        bounds.append(bounds_pool["thr"])

    for i in range(npools):
        bounds.append(bounds_pool["pd"])

    return bounds

def unpack_params(x, npools):
    params = {}
    index = 0

    pr_min = x[index]
    params["pr_min"] = pr_min
    index += 1

    M = [0] * npools
    for i in range(1, npools):
        M[i] = int(round(x[index]))
        index += 1

