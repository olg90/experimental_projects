def simulate(n1init,n2init,pr1,pr2,k1,k2,M1,M2,nstim,navgs):
    bmeanlist=[]
    for _ in range(navgs):
        blist=[]
        n1=n1init
        n2=n2init
        for i in range(nstim):
            if i!=0:
                n1+=binomial(M1-n1,p1d(i))
                n2+=binomial(M2-n2,p2d)
            b1=binomial(n1,pr1)
            b2=binomial(n2,pr2)
            n1-=b1
            n2-=b2
            blist.append(b1+b2)
        bmeanlist.append(blist)

    bmeanlist=np.asarray(bmeanlist)
    ff=np.var(bmeanlist,axis=0)/np.mean(bmeanlist,axis=0)
    bmean=np.mean(bmeanlist,axis=0)

    return bmean,ff,bmeanlist

def p1d(i):
    return prefillmin+(prefill-prefillmin)/(1+((i)/thr)**hill)

