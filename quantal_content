import numpy as np
import pandas as pd
import os
import matplotlib.pyplot as plt

os.chdir(r'C:\Users\Oliver\Desktop\Research\quantal content')

file1 = '100Hz_1s_20_repeats_P11.xlsx'
file2 = '100Hz_1s_20_repeats_P38.xlsx'

excel1 = pd.read_excel(file1, sheet_name=None, header=None)
excel2 = pd.read_excel(file2, sheet_name=None, header=None)

# (cell, time, repeat)
data1 = np.array([df.to_numpy()[1:, 1:] for df in excel1.values()])
data2 = np.array([df.to_numpy()[1:, 1:] for df in excel2.values()])

data = [data1, data2]

times = np.array(list(excel1.values())[0].to_numpy()[1:, 0])

# -----------------------------
# normalize each repeat by its first value
# then average repeats -> cell trace
# then average cells -> condition trace
# -----------------------------

norm_cells = []

for fnum in [0, 1]:  # P11, P38
    cell_traces = []

    for dnum in range(data[fnum].shape[0]):  # cells
        cell = data[fnum][dnum]  # time x repeats

        norm_repeats = np.zeros_like(cell, dtype=float)

        for r in range(cell.shape[1]):
            trace = cell[:, r]
            base = trace[0]

            if base != 0:
                norm_repeats[:, r] = trace / base
            else:
                norm_repeats[:, r] = trace

        # average across repeats (within cell)
        cell_mean = np.mean(norm_repeats, axis=1)

        cell_traces.append(cell_mean)

    norm_cells.append(np.array(cell_traces))

# -----------------------------
# average across cells ONLY (no SEM, no std)
# -----------------------------

p11_mean = np.mean(norm_cells[0], axis=0)
p38_mean = np.mean(norm_cells[1], axis=0)

# -----------------------------
# plot
# -----------------------------

plt.figure()

plt.plot(times, p11_mean, label='P11', linewidth=2)
plt.plot(times, p38_mean, label='P38', linewidth=2)

plt.xlabel('Time (sec)')
plt.ylabel('Normalized QC')
plt.title('P11 vs P38 QC dynamics (repeat-normalized, cell-averaged)')
