ms = 8
markevery = 5

# =============================================================================
# Test definitions
# =============================================================================

test_names = [
    'Fixed pr per pool, decreasing pd',
    'Fixed pr per pool, decreasing pd; pd2 fixed',
    'Increasing pr, fixed pd per pool',
    'Increasing pr; pr2 fixed, fixed pd per pool',
    'Shared fixed pr, decreasing pd',
    'Shared fixed pr, decreasing pd; pd2 fixed',
    'Increasing pr, shared fixed pd',
    'Increasing pr; pr2 fixed, shared fixed pd'
]

test_configs = [
    {'family': 'fixed_pr_decreasing_pd', 'shared': False, 'special': False},
    {'family': 'fixed_pr_decreasing_pd', 'shared': False, 'special': True},
    {'family': 'increasing_pr_fixed_pd', 'shared': False, 'special': False},
    {'family': 'increasing_pr_fixed_pd', 'shared': False, 'special': True},
    {'family': 'fixed_pr_decreasing_pd', 'shared': True, 'special': False},
    {'family': 'fixed_pr_decreasing_pd', 'shared': True, 'special': True},
    {'family': 'increasing_pr_fixed_pd', 'shared': True, 'special': False},
    {'family': 'increasing_pr_fixed_pd', 'shared': True, 'special': True}
]

bounds_pool = {
    'pr_min': (0.01, 1),
    'pr_max': (0.01, 1),
    'pr2': (0.01, 1),
    'pr': (0.01, 1),
    'M': (0, 100),
    'pd': (0, 1),
    'pd_max': (0, 1),
    'pd_min': (0, 1),
    'hill': (0.01, 10),
    'thr': (0.01, 100)
}

penalty = 1e100

# =============================================================================
# Probability functions
# =============================================================================

def pr_dynamic(i, pr_min, pr_max, thr, hill):
    return pr_min + (pr_max - pr_min) * (
        i**hill / (thr**hill + i**hill)
    )

def pd_dynamic(i, pd_max, pd_min, thr, hill):
    return pd_min + (pd_max - pd_min) * (
        thr**hill / (thr**hill + i**hill)
    )

def update_pool_probability(p_previous, pr, pd):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * pd

def get_pool_value(value, j):
    if np.isscalar(value):
        return value
    return value[j]

# =============================================================================
# Parameter names and bounds
# =============================================================================

def create_param_names(npools, tnum):

    config = test_configs[tnum]
    family = config['family']
    shared = config['shared']
    special = config['special']

    names = [f'M{i+1}' for i in range(1, npools)]

    if family == 'fixed_pr_decreasing_pd':

        if shared:
            names.append('pr_shared')
        else:
            names.extend([f'pr{i+1}' for i in range(npools)])

        if special and npools >= 2:
            names.append('pd2')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'pd_max{i+1}')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'pd_min{i+1}')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'hill{i+1}')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'thr{i+1}')

    else:

        names.append('pr_min')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'pr_max{i+1}')
            elif i == 1:
                names.append('pr2')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'hill{i+1}')

        for i in range(npools):
            if not special or i != 1:
                names.append(f'thr{i+1}')

        if shared:
            names.append('pd_shared')
        else:
            names.extend([f'pd{i+1}' for i in range(npools)])

    return names

def create_bounds(npools, tnum):

    config = test_configs[tnum]
    family = config['family']
    shared = config['shared']
    special = config['special']

    bounds = [bounds_pool['M'] for i in range(1, npools)]

    if family == 'fixed_pr_decreasing_pd':

        if shared:
            bounds.append(bounds_pool['pr'])
        else:
            bounds.extend([bounds_pool['pr'] for i in range(npools)])

        if special and npools >= 2:
            bounds.append(bounds_pool['pd'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['pd_max'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['pd_min'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['hill'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['thr'])

    else:

        bounds.append(bounds_pool['pr_min'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['pr_max'])
            elif i == 1:
                bounds.append(bounds_pool['pr2'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['hill'])

        for i in range(npools):
            if not special or i != 1:
                bounds.append(bounds_pool['thr'])

        if shared:
            bounds.append(bounds_pool['pd'])
        else:
            bounds.extend([bounds_pool['pd'] for i in range(npools)])

    return bounds

# =============================================================================
# Unpack optimized parameters
# =============================================================================

def unpack_params(x, npools, tnum):

    config = test_configs[tnum]
    family = config['family']
    shared = config['shared']
    special = config['special']

    params = {}
    index = 0

    M = [0] * npools

    for i in range(1, npools):
        M[i] = int(round(x[index]))
        index += 1

    if family == 'fixed_pr_decreasing_pd':

        if shared:
            params['pr_fixed'] = x[index]
            index += 1
        else:
            params['pr_fixed'] = list(x[index:index + npools])
            index += npools

        params['pd2'] = None

        if special and npools >= 2:
            params['pd2'] = x[index]
            index += 1

        params['pd_max'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['pd_max'][i] = x[index]
                index += 1

        params['pd_min'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['pd_min'][i] = x[index]
                index += 1

        params['hill'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['hill'][i] = x[index]
                index += 1

        params['thr'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['thr'][i] = x[index]
                index += 1

        other_M = np.sum([
            M[j] * get_pool_value(params['pr_fixed'], j)
            for j in range(1, npools)
        ])

        M[0] = int(round(
            (mean_data[0] - other_M) /
            get_pool_value(params['pr_fixed'], 0)
        ))

    else:

        params['pr_min'] = x[index]
        index += 1

        params['pr_max'] = [None] * npools
        params['pr2'] = None

        for i in range(npools):
            if special and i == 1:
                params['pr2'] = x[index]
            else:
                params['pr_max'][i] = x[index]
            index += 1

        params['hill'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['hill'][i] = x[index]
                index += 1

        params['thr'] = [None] * npools

        for i in range(npools):
            if not special or i != 1:
                params['thr'][i] = x[index]
                index += 1

        if shared:
            params['pd_fixed'] = x[index]
            index += 1
        else:
            params['pd_fixed'] = list(x[index:index + npools])
            index += npools

        other_M = np.sum([
            M[j] * (
                params['pr2'] if special and j == 1
                else params['pr_min']
            )
            for j in range(1, npools)
        ])

        M[0] = int(round(
            (mean_data[0] - other_M) / params['pr_min']
        ))

    params['M'] = M

    return params

# =============================================================================
# Model calculations
# =============================================================================

def model(params, tnum):

    config = test_configs[tnum]
    family = config['family']
    special = config['special']

    npools = len(params['M'])

    pool_probability = []
    pool_pr = []
    pool_pd = []
    pool_mqc = []

    for j in range(npools):

        if family == 'increasing_pr_fixed_pd':

            if special and j == 1:
                pr = np.full(nstim, params['pr2'])
            else:
                pr = pr_dynamic(
                    np.arange(nstim),
                    params['pr_min'],
                    params['pr_max'][j],
                    params['thr'][j],
                    params['hill'][j]
                )

        else:
            pr = np.full(
                nstim,
                get_pool_value(params['pr_fixed'], j)
            )

        if family == 'fixed_pr_decreasing_pd':

            if special and j == 1:
                pd = np.full(nstim, params['pd2'])
            else:
                pd = pd_dynamic(
                    np.arange(nstim),
                    params['pd_max'][j],
                    params['pd_min'][j],
                    params['thr'][j],
                    params['hill'][j]
                )

        else:
            pd = np.full(
                nstim,
                get_pool_value(params['pd_fixed'], j)
            )

        p = np.ones(nstim)

        for i in range(1, nstim):
            p[i] = update_pool_probability(
                p[i - 1],
                pr[i - 1],
                pd[i - 1]
            )

        pool_probability.append(p)
        pool_pr.append(pr)
        pool_pd.append(pd)
        pool_mqc.append(params['M'][j] * p * pr)

    mqc = np.sum(pool_mqc, axis=0)

    vqc = np.sum([
        M * p * pr * (1 - p * pr)
        for M, p, pr in zip(params['M'], pool_probability, pool_pr)
    ], axis=0)

    vei = mqc * CVq**2 + vqc
    CV2 = vei / mqc**2
    FF = vei / mqc

    return {
        'mqc': mqc,
        'CV2': CV2,
        'FF': FF,
        'pool_mqc': pool_mqc,
        'pool_probability': pool_probability,
        'pool_pr': pool_pr,
        'pool_pd': pool_pd
    }

# =============================================================================
# Maximum likelihood estimation
# =============================================================================

def mle(x, npools, tnum):

    params = unpack_params(x, npools, tnum)
    config = test_configs[tnum]
    family = config['family']
    special = config['special']

    if params['M'][0] <= 0:
        return penalty

    if family == 'increasing_pr_fixed_pd':

        for j in range(npools):
            if not special or j != 1:
                if params['pr_max'][j] < params['pr_min']:
                    return penalty

    else:

        for j in range(npools):
            if not special or j != 1:
                if params['pd_min'][j] >= params['pd_max'][j]:
                    return penalty

    result = model(params, tnum)

    mqc = result['mqc']
    CV2 = result['CV2']

    if np.any(mqc <= 0) or np.any(CV2 <= 0):
        return penalty

    shape = 1 / CV2
    scale = mqc * CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return penalty

    loglik = gamma.logpdf(
        obs,
        a=shape[:, None],
        scale=scale[:, None]
    )

    if np.any(~np.isfinite(loglik)):
        return penalty

    return -np.sum(loglik)

# =============================================================================
# Optimize one pool configuration
# =============================================================================

def opt(npools, tnum):

    bounds = create_bounds(npools, tnum)
    names = create_param_names(npools, tnum)

    result = differential_evolution(
        lambda x: mle(x, npools, tnum),
        bounds,
        maxiter=maxiter,
        popsize=popsize,
        tol=tol,
        polish=True,
        workers=1,
        updating='immediate'
    )

    params = unpack_params(result.x, npools, tnum)
    AIC = 2 * len(bounds) + 2 * result.fun

    print(f'\nTest {tnum}: {test_names[tnum]}')
    print(f'{npools} pool model')

    for name, value in zip(names, result.x):
        print(f'{name}={value}')

    print(f'M1={params["M"][0]}')
    print(f'M={params["M"]}')
    print(f'AIC={AIC}')

    return {
        'params': params,
        'result': result,
        'AIC': AIC,
        'model': model(params, tnum)
    }

# =============================================================================
# Run selected test across 1-4 pools
# =============================================================================

def run_test(tnum):

    if not isinstance(tnum, (int, np.integer)) or tnum not in range(8):
        raise ValueError('tnum must be an integer from 0 to 7.')

    print('\n' + '=' * 75)
    print(f'TEST {tnum}: {test_names[tnum]}')
    print('=' * 75)

    results = {}

    for npools in range(1, 5):

        results[npools] = opt(npools, tnum)

        if (
            npools > 1
            and results[npools]['AIC'] > results[npools - 1]['AIC']
        ):
            break

    best_model = min(results, key=lambda i: results[i]['AIC'])
    best_result = results[best_model]

    print(f'\nBest model: {best_model} pools')
    print(f'AIC={best_result["AIC"]}')

    return {
        'results': results,
        'best_model': best_model,
        'best_result': best_result
    }

# =============================================================================
# Format parameter values
# =============================================================================

def fmt(x):

    x = float(x)

    if x != 0 and abs(x) < 1e-3:
        return f'{x:.3e}'

    return f'{x:.3f}'

# =============================================================================
# Print best-fit parameters
# =============================================================================

def print_best_parameters(result, tnum):

    best_model = result['best_model']
    best_result = result['best_result']
    params = best_result['params']

    print('\n' + '=' * 75)
    print(f'BEST-FIT PARAMETERS: TEST {tnum}')
    print('=' * 75)

    print(f'Test: {test_names[tnum]}')
    print(f'Best model: {best_model} pools')
    print(f'AIC={fmt(best_result["AIC"])}')

    for name, value in params.items():

        if value is None:
            continue

        if np.isscalar(value):
            print(f'{name}={fmt(value)}')

        elif name == 'M':
            s = ', '.join(str(int(round(v))) for v in value)
            print(f'{name}=[{s}]')

        else:
            s = ', '.join(
                fmt(v) if v is not None else 'None'
                for v in value
            )
            print(f'{name}=[{s}]')

    print(f'CVq={fmt(CVq)}')

