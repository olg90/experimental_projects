data1 = np.array([df.to_numpy()[1:, 1:] for df in excel1.values()])
data2 = np.array([df.to_numpy()[1:, 1:] for df in excel2.values()])

data = [data1, data2]

n_boot = 500
ci_low, ci_high = 2.5, 97.5

for fnum in range(len(data)):

    for dnum in range(len(data[fnum])):

        ds = np.asarray(data[fnum][dnum], dtype=float)  # (time, repeats)

        n_time, n_rep = ds.shape

        # =====================================================
        # bootstrap CI per time point across repeats
        # =====================================================
        lower = np.zeros(n_time)
        upper = np.zeros(n_time)

        for i in range(n_time):

            samples = ds[i, :]

            boots = np.empty(n_boot)

            for b in range(n_boot):
                resamp = np.random.choice(samples, size=len(samples), replace=True)
                boots[b] = np.mean(resamp)

            lower[i] = np.percentile(boots, ci_low)
            upper[i] = np.percentile(boots, ci_high)

        # =====================================================
        # plot each repeat only if it violates CI
        # =====================================================
        violating_runs = []

        for run in range(n_rep):

            trace = ds[:, run]

            out_of_bounds = (trace < lower) | (trace > upper)

            # ignore first point (optional stability)
            out_of_bounds[0] = False

            if np.any(out_of_bounds):

                violating_runs.append((run, trace, out_of_bounds))

        # =====================================================
        # skip empty cells
        # =====================================================
        if len(violating_runs) == 0:
