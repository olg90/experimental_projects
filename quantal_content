#%% 2- Minimize MLE - LFGS
import numpy as np
from scipy.optimize import minimize
from scipy.stats import gamma
import matplotlib.pyplot as plt

obs = np.asarray(data[fnum][dnum], dtype=float)
nstim = obs.shape[0]
mean_data = np.mean(obs, axis=1)

# Calculate model statistics
def get_model(params):
    pr1, pr2, pr3, M2, M3, hill, thr, prefill1, prefill2, prefill3, prefillmin, CVq = params
    M1 = mean_data[0]/pr1 - M2 - M3

    # Depletion/refill probabilities
    p1d = np.array([prefillmin+(prefill1-prefillmin)/(1+(i/thr)**hill) for i in range(nstim)])
    p2d = prefill2*np.ones(nstim)
    p3d = prefill3*np.array([1/(i+1) for i in range(nstim)])

    # Initial available vesicle probabilities
    p1i = np.ones(nstim)
    p2i = np.ones(nstim)
    p3i = np.ones(nstim)

    # Recursive refill dynamics
    for i in range(1,nstim):
        p1i[i] = p1i[i-1]*(1-pr1)+(1-p1i[i-1]*(1-pr1))*p1d[i-1]
        p2i[i] = p2i[i-1]*(1-pr2)+(1-p2i[i-1]*(1-pr2))*p2d[i-1]
        p3i[i] = p3i[i-1]*(1-pr3)+(1-p3i[i-1]*(1-pr3))*p3d[i-1]

    # Mean quantal content
    mqc = M1*p1i*pr1 + M2*p2i*pr2 + M3*p3i*pr3

    # Quantal variance
    vqc = M1*p1i*pr1*(1-p1i*pr1) + M2*p2i*pr2*(1-p2i*pr2) + M3*p3i*pr3*(1-p3i*pr3)

    # Include quantal size variability
    vei = mqc*CVq**2 + vqc
    CV2 = vei/(mqc**2)
    FF = vei/mqc

    return mqc, CV2, FF

# Negative log likelihood
def mle(params):
    mqc, CV2, FF = get_model(params)

    if np.any(mqc <= 0) or np.any(CV2 <= 0):
        return np.inf

    shape = 1/CV2
    scale = mqc*CV2

    if np.any(shape <= 0) or np.any(scale <= 0):
        return np.inf

    loglik = gamma.logpdf(obs, a=shape[:,None], scale=scale[:,None])

    if np.any(~np.isfinite(loglik)):
        return np.inf

    return -np.sum(loglik)

