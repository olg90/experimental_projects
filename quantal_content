# =============================================================================
# Probability functions
# =============================================================================

def pr_dynamic(i, pr_min, pr_max, thr, hill):
    return pr_min + (pr_max - pr_min) * (
        i**hill / (thr**hill + i**hill)
    )

def pd_dynamic(i, pd_max, pd_min, thr, hill):
    return pd_min + (pd_max - pd_min) * (
        thr**hill / (thr**hill + i**hill)
    )

def update_pool_probability(p_previous, pr, pd):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * pd

def get_pool_value(value, j):
    if np.isscalar(value):
        return value
    return value[j]

# =============================================================================
