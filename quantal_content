def pd_dynamic(i, pd_max, pd_min, thr, hill):
    # Replenishment probability decreases from pd_max toward pd_min.
    return pd_min + (pd_max - pd_min) * (
        thr**hill / (thr**hill + i**hill)
    )

def update_pool_probability(p_previous, pr, pd):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * pd

def model(params):
    npools = len(params["M"])
    pool_probability = []
    pool_pd = []
    pool_mqc = []

    for j in range(npools):
        pr = np.full(nstim, params["pr"][j])

        if j == 1:
            pd = np.full(nstim, params["pd2"])
        else:
            pd = pd_dynamic(
                np.arange(nstim),
                params["pd_max"][j],
                params["pd_min"][j],
                params["thr"][j],
                params["hill"][j]
            )

        p = np.ones(nstim)

        for i in range(1, nstim):
            p[i] = update_pool_probability(
                p[i - 1],
                pr[i - 1],
                pd[i - 1]
            )

        pool_probability.append(p)
        pool_pd.append(pd)
        pool_mqc.append(params["M"][j] * p * pr)

    mqc = np.sum(pool_mqc, axis=0)

    vqc = np.sum([
        M * p * pr * (1 - p * pr)
        for M, p, pr in zip(
            params["M"],
            pool_probability,
            [np.full(nstim, pr) for pr in params["pr"]]
        )
    ], axis=0)

    vei = mqc * CVq**2 + vqc
    CV2 = vei / (mqc**2)
    FF = vei / mqc

    return {
        "mqc": mqc,
        "CV2": CV2,
        "FF": FF,
        "pool_mqc": pool_mqc,
        "pool_probability": pool_probability,
        "pool_pd": pool_pd
    }

