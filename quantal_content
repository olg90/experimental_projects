        p2i[i] = p2i[i-1]*(1-pr2)+(1-p2i[i-1]*(1-pr2))*p2d(i-1,prefill2)
        p3i[i] = p3i[i-1]*(1-pr3)+(1-p3i[i-1]*(1-pr3))*p3d(i-1,prefill3,prefillmin3,thr3,hill3)
        p4i[i] = p4i[i-1]*(1-pr4)+(1-p4i[i-1]*(1-pr4))*p4d(i-1,prefill4,prefillmin4,thr4,hill4)
        p5i[i] = p5i[i-1]*(1-pr5)+(1-p5i[i-1]*(1-pr5))*p5d(i-1,prefill5,prefillmin5,thr5,hill5)
    
    mqc1=M1*p1i*pr1
    mqc2=M2*p2i*pr2
    mqc3=M3*p3i*pr3
    mqc4=M4*p4i*pr4
    mqc5=M5*p5i*pr5
    mqc=mqc1+mqc2+mqc3+mqc4+mqc5
    vqc = (M1*p1i*pr1*(1-p1i*pr1)+
           M2*p2i*pr2*(1-p2i*pr2)+
           M3*p3i*pr3*(1-p3i*pr3)+
