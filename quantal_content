    "thr": (0.01, 100)
}

penalty = 1e100

def pr_dynamic(i, pr_min, pr_max, thr, hill):
    return pr_min + (pr_max - pr_min) * (
        i**hill / (thr**hill + i**hill)
    )

def pd_dynamic(i, pd_max, pd_min, thr, hill):
    return pd_min + (pd_max - pd_min) * (
        thr**hill / (thr**hill + i**hill)
    )

def update_pool_probability(p_previous, pr, pd):
    return p_previous * (1 - pr) + (
        1 - p_previous * (1 - pr)
    ) * pd

# =============================================================================
# Model calculations
# =============================================================================

def model(params, test_type):

    npools = len(params["M"])

    pool_probability = []
    pool_pr = []
    pool_pd = []
    pool_mqc = []

    for j in range(npools):

        # ---------------------------------------------------------------------
        # Release probability
        # ---------------------------------------------------------------------

        if test_type in [
            'increasing_pr_fixed_pd',
            'increasing_pr2_fixed_pd'
        ]:

            if test_type == 'increasing_pr2_fixed_pd' and j == 1:
                pr = np.full(nstim, params["pr2"])
            else:
                pr = pr_dynamic(
                    np.arange(nstim),
                    params["pr_min"],
                    params["pr_max"][j],
                    params["thr"][j],
                    params["hill"][j]
                )

        else:
            pr = np.full(nstim, params["pr"][j])

        # ---------------------------------------------------------------------
        # Replenishment probability
        # ---------------------------------------------------------------------

        if test_type in [
            'fixed_pr_decreasing_pd',
            'fixed_pr_decreasing_pd2_fixed'
        ]:

            if test_type == 'fixed_pr_decreasing_pd2_fixed' and j == 1:
                pd = np.full(nstim, params["pd2"])
            else:
                pd = pd_dynamic(
                    np.arange(nstim),
                    params["pd_max"][j],
                    params["pd_min"][j],
                    params["thr"][j],
                    params["hill"][j]
                )

        else:
            pd = np.full(nstim, params["pd"][j])

        # ---------------------------------------------------------------------
        # Pool availability
        # ---------------------------------------------------------------------

        p = np.ones(nstim)

        for i in range(1, nstim):
            p[i] = update_pool_probability(
                p[i - 1],
                pr[i - 1],
                pd[i - 1]
            )

        pool_probability.append(p)
        pool_pr.append(pr)
        pool_pd.append(pd)
        pool_mqc.append(params["M"][j] * p * pr)

    # -------------------------------------------------------------------------
    # Total mean quantal content and variance
    # -------------------------------------------------------------------------

    mqc = np.sum(pool_mqc, axis=0)

    vqc = np.sum([
        M * p * pr * (1 - p * pr)
        for M, p, pr in zip(
            params["M"],
            pool_probability,
            pool_pr
        )
    ], axis=0)

    vei = mqc * CVq**2 + vqc
    CV2 = vei / (mqc**2)
    FF = vei / mqc

    return {
        "mqc": mqc,
        "CV2": CV2,
        "FF": FF,
        "pool_mqc": pool_mqc,
        "pool_probability": pool_probability,
        "pool_pr": pool_pr,
        "pool_pd": pool_pd
    }

