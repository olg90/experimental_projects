#%% 3 - calculate the analysis for the Lisa data

import numpy as np

n_boot = 10000
rng = np.random.default_rng(0)

n_cells = len(data3)
n_tests = len(data3[0])

total_jobs = n_cells * n_tests

results = [[None for _ in range(n_tests)] for _ in range(n_cells)]

job = 0

for cell in range(n_cells):
    for test in range(n_tests):

        job += 1

        X = np.asarray(data3[cell][test], dtype=float)

        n_time, n_repeats = X.shape

        # -------------------------
        # Mean + CI
        # -------------------------

        mean_trace = np.nanmean(X, axis=1)

        boot_means = np.empty((n_boot, n_time))

        for b in range(n_boot):
            idx = rng.integers(0, n_repeats, n_repeats)
            boot_means[b] = np.nanmean(X[:, idx], axis=1)

        mean_lo = np.percentile(boot_means, 2.5, axis=0)
        mean_hi = np.percentile(boot_means, 97.5, axis=0)

        print(
            f"Mean/CI: {100*job/total_jobs:.1f}% complete "
            f"({job}/{total_jobs})"
        )

        # -------------------------
        # Normalized repeats
        # -------------------------

        normX = X / X[0:1, :]
        norm_mean = np.nanmean(normX, axis=1)

        print(
            f"Normalization: {100*job/total_jobs:.1f}% complete "
            f"({job}/{total_jobs})"
        )

        # -------------------------
        # Fano factor + CI
        # -------------------------

        fano = np.nanvar(X, axis=1, ddof=1) / np.nanmean(X, axis=1)

        boot_fano = np.empty((n_boot, n_time))

        for b in range(n_boot):
            idx = rng.integers(0, n_repeats, n_repeats)

            Xb = X[:, idx]

            m = np.nanmean(Xb, axis=1)
            v = np.nanvar(Xb, axis=1, ddof=1)

            boot_fano[b] = v / m

        fano_lo = np.percentile(boot_fano, 2.5, axis=0)
        fano_hi = np.percentile(boot_fano, 97.5, axis=0)

        print(
            f"Fano/CI: {100*job/total_jobs:.1f}% complete "
            f"({job}/{total_jobs})"
        )

        results[cell][test] = {
            'raw': X,
            'mean': mean_trace,
            'mean_lo': mean_lo,
            'mean_hi': mean_hi,
            'norm': normX,
            'norm_mean': norm_mean,
            'fano': fano,
            'fano_lo': fano_lo,
            'fano_hi': fano_hi
        }
        
np.save('results.npy',results)

