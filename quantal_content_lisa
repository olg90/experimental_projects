    for test in range(len(data3[cell])):

        ds = np.asarray(data3[cell][test], dtype=float)  # (pulse, repeats)

        # =====================================================
        # mean + std across repeats at each pulse
        # =====================================================

        mean = np.mean(ds, axis=1)
        std = np.std(ds, axis=1)

        upper = mean + ndev * std
        lower = mean - ndev * std

        all_runs = []

        for run in range(ds.shape[1]):

            trace = ds[:, run]

            out_of_bounds = (
                (trace > upper) |
                (trace < lower)
            )

            # ignore first pulse only for detection
            out_of_bounds[0] = False

            all_runs.append(
                (run, trace, out_of_bounds)
            )

        nplots = len(all_runs)

        # =========================
        # balanced grid (closest to square)
        # =========================
        ncols = math.ceil(np.sqrt(nplots))
        nrows = math.ceil(nplots / ncols)

        fig, axes = plt.subplots(
            nrows,
            ncols,
            figsize=(4 * ncols, 3 * nrows),
            squeeze=False
        )

        axes = axes.flatten()

        for k, (run, trace, mask) in enumerate(all_runs):

            ax = axes[k]

            ax.plot(
                t,
                trace,
                linewidth=1,
                label='Repeat'
            )

            ax.plot(
                t,
                mean,
                '--',
                linewidth=1,
                label='Mean'
            )

            ax.plot(
                t,
                upper,
                ':',
                linewidth=1,
                label=f'+{ndev} SD'
            )

            ax.plot(
                t,
                lower,
                ':',
                linewidth=1,
                label=f'-{ndev} SD'
            )

            ax.fill_between(
                t,
                lower,
                upper,
                alpha=0.15
            )

            ax.scatter(
                t[mask],
                trace[mask],
                color='red',
                s=20,
                label='Out of bounds'
            )

            ax.set_title(
                f'Repeat {run + 1}',
                fontsize=fs
            )

            ax.set_xlabel(
                'Pulse #',
                fontsize=fs
            )

            ax.set_ylabel(
                'QC',
                fontsize=fs
            )

            ax.tick_params(
                labelsize=fs
            )

            if k == 0:
                ax.legend(
                    fontsize=fs-2,
                    frameon=False
                )

        for k in range(nplots, len(axes)):
            fig.delaxes(axes[k])

        fig.suptitle(
            f'{files3[cell]} : {d3names[test]}',
            fontsize=fs
        )

        plt.tight_layout()
