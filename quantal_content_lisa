}

def p_dynamic(i,pr_min,pr_max,thr,hill):
    i=np.asarray(i,dtype=float)
    return pr_min+(pr_max-pr_min)/(1+(thr/np.maximum(i,1e-12))**hill)

def update_pool_probability(p_previous,pd):
    return p_previous*(1-pd)+(1-p_previous*(1-pd))*pd

def model(params):
    npools=len(params["M"])
    pool_probability=[]
    pool_mqc=[]
    fusion_probability=[]

    for j in range(npools):
        p=np.ones(nstim)

        for i in range(1,nstim):
            p[i]=update_pool_probability(p[i-1],params["pd"][j])

        pool_probability.append(p)

        pr=p_dynamic(
            np.arange(1,nstim+1),
            params["pr_min"][j],
            params["pr_max"][j],
            params["thr"][j],
            params["hill"][j]
        )

        fusion_probability.append(pr)
        pool_mqc.append(params["M"][j]*p*pr)

    mqc=np.sum(pool_mqc,axis=0)

    vqc=np.sum(
        [M*p*pr*(1-p*pr) for M,p,pr in zip(params["M"],pool_probability,fusion_probability)],
        axis=0
    )

    vei=mqc*CVq**2+vqc
    CV2=vei/(mqc**2)
    FF=vei/mqc

    return {
        "mqc":mqc,
        "CV2":CV2,
        "FF":FF,
        "pool_mqc":pool_mqc,
        "pool_probability":pool_probability,
        "fusion_probability":fusion_probability
    }

def create_param_names(npools):
    names=[]
    for i in range(npools):
        names.append(f'M{i+1}')
    for i in range(npools):
        names.append(f'pd{i+1}')
    for i in range(npools):
        names.append(f'pr_max{i+1}')
    for i in range(npools):
        names.append(f'hill{i+1}')
    for i in range(npools):
        names.append(f'thr{i+1}')
    return names

def create_bounds(npools):
    bounds=[]
    for key in ["M","pd","pr_max","hill","thr"]:
        bounds.extend([bounds_pool[key]]*npools)
    return bounds

def unpack_params(x,npools):
    params={}
    index=0

    params["M"]=[int(round(v)) for v in x[index:index+npools]]
    index+=npools

    params["pd"]=list(x[index:index+npools])
    index+=npools

    params["pr_max"]=list(x[index:index+npools])
    index+=npools

    params["hill"]=list(x[index:index+npools])
    index+=npools

    params["thr"]=list(x[index:index+npools])

    # The first stimulus has p=1 in every pool.
    # Set the first-stimulus total mean exactly equal to the data.
    #
    # For each pool:
    # pr(1) = pr_min + (pr_max-pr_min)/(1+thr**hill)
    #
    # Solve the total-mean constraint for the shared pr_min,
    # then assign it to every pool. This preserves pr_min < pr_max
    # only if the resulting pr_min is below the smallest pr_max.

    M=np.asarray(params["M"],dtype=float)
    pr_max=np.asarray(params["pr_max"],dtype=float)
    hill=np.asarray(params["hill"],dtype=float)
    thr=np.asarray(params["thr"],dtype=float)

    w=1/(1+thr**hill)
    denominator=np.sum(M*(1-w))
    numerator=bmean1data-np.sum(M*pr_max*w)

    if denominator<=0:
        params["pr_min"]=[np.nan]*npools
    else:
        pr_min=numerator/denominator
        params["pr_min"]=[pr_min]*npools

    return params

def mle(x,npools):
    params=unpack_params(x,npools)

    if np.any(np.asarray(params["M"])<15) or np.any(np.asarray(params["M"])>30):
        return np.inf

    pr_min=np.asarray(params["pr_min"])
    pr_max=np.asarray(params["pr_max"])

    if np.any(~np.isfinite(pr_min)) or np.any(pr_min<=0) or np.any(pr_min>=pr_max):
        return np.inf

    result=model(params)
    mqc=result["mqc"]
    CV2=result["CV2"]

    if not np.isclose(mqc[0],bmean1data,rtol=1e-10,atol=1e-12):
        return np.inf

    if np.any(mqc<=0) or np.any(CV2<=0):
        return np.inf

    shape=1/CV2
    scale=mqc*CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return np.inf

    loglik=gamma.logpdf(obs,a=shape[:,None],scale=scale[:,None])

    if np.any(~np.isfinite(loglik)):
        return np.inf

    return -np.sum(loglik)

def opt(npools):
    bounds=create_bounds(npools)
    names=create_param_names(npools)

    result=differential_evolution(
        lambda x:mle(x,npools),
        bounds,
        maxiter=1000,
        popsize=20,
        tol=1e-9,
        polish=True,
        workers=1,
        updating='immediate'
    )

    params=unpack_params(result.x,npools)
    model_result=model(params)
    AIC=2*len(bounds)+2*result.fun

    print(f'{npools} pool model')

    for name,value in zip(names,result.x):
        print(f'{name}={value}')

    print(f'M={params["M"]}')
    print(f'pd={params["pd"]}')
    print(f'pr_min={params["pr_min"]}')
    print(f'pr_max={params["pr_max"]}')
    print(f'hill={params["hill"]}')
    print(f'thr={params["thr"]}')
    print(f'bmean1data={bmean1data:.12g}')
    print(f'bmean1sim={model_result["mqc"][0]:.12g}')
    print(f'First mean matched: {np.isclose(model_result["mqc"][0],bmean1data,rtol=1e-10,atol=1e-12)}')
    print(f'AIC={AIC}')

    return {
        "params":params,
        "result":result,
        "AIC":AIC,
        "model":model_result
    }

