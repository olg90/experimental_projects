    # 3:20,
}

if dnum in stim_keep:
    obs=obs[:stim_keep[dnum],:]

nstim=obs.shape[0]
mean_data=np.mean(obs,axis=1)

CVq=0.2
fs=15
lw=3

bounds=[
    (15,30),  # M
    (0.01,1)  # pd
]

def update_pool_probability(p_previous,pr,pd):
    return p_previous*(1-pr)+(1-p_previous*(1-pr))*pd

def calculate_fusion_probability(M,pd,mean_data):
    pr=np.zeros(len(mean_data))
    p=np.ones(len(mean_data))

    pr[0]=mean_data[0]/M

    for i in range(1,len(mean_data)):
        p[i]=update_pool_probability(
            p[i-1],
            pr[i-1],
            pd
        )

        if p[i]<=0:
            return None,None

        pr[i]=mean_data[i]/(M*p[i])

    return p,pr

def model(params):
    p,pr=calculate_fusion_probability(
        params["M"],
        params["pd"],
        mean_data
    )

    if p is None:
        return None

    mqc=params["M"]*p*pr
    vqc=params["M"]*p*pr*(1-p*pr)
    vei=mqc*CVq**2+vqc

    CV2=vei/(mqc**2)
    FF=vei/mqc

    return {
        "mqc":mqc,
        "CV2":CV2,
        "FF":FF,
        "pool_mqc":[mqc],
        "pool_probability":[p],
        "fusion_probability":[pr]
    }

def unpack_params(x):
    return {
        "M":int(round(x[0])),
        "pd":x[1]
    }

def mle(x):
    params=unpack_params(x)

    if params["M"]<15 or params["M"]>30:
        return np.inf

    result=model(params)

    if result is None:
        return np.inf

    pr=np.asarray(result["fusion_probability"][0])
    mqc=result["mqc"]
    CV2=result["CV2"]

    if np.any(~np.isfinite(pr)) or np.any(pr<=0) or np.any(pr>1):
        return np.inf

    if np.any(mqc<=0) or np.any(CV2<=0):
        return np.inf

    shape=1/CV2
    scale=mqc*CV2

    if np.any(~np.isfinite(shape)) or np.any(~np.isfinite(scale)):
        return np.inf

    loglik=gamma.logpdf(
        obs,
        a=shape[:,None],
        scale=scale[:,None]
    )

    if np.any(~np.isfinite(loglik)):
        return np.inf

    return -np.sum(loglik)

