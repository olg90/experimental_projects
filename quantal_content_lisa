import numpy as np
import matplotlib.pyplot as plt
from numpy.random import exponential, binomial

def sim(ninit,nuinit,pr,taup,M,kin,kd,tauc,c,cb,delta_t,aptimerinit,naps,navgs):

    bavs=[]

    for _ in range(navgs):

        nlist=[]
        nulist=[]
        blist=[]
        calist=[]
        tlist=[]
        prelist=[]

        n=ninit
        nu=nuinit
        ca=cb
        tcurr=0
        timer=delta_t
        apcount=0
        aptimer=0
        e=1e-6

        nlist.append(n)
        nulist.append(nu)
        tlist.append(tcurr)
        calist.append(ca)

        while apcount<naps:

            t0=exponential(1/(kin+e))
            t1=exponential(1/(kd*nu*(M-n)+e))
            t2=aptimer
            t3=timer

            if t0<t1 and t0<t2 and t0<t3:
                nu+=1
                tmin=t0
                aptimer-=tmin
                timer-=tmin

            elif t1<t0 and t1<t2 and t1<t3:
                nu-=1
                n+=1
                tmin=t1
                aptimer-=tmin
                timer-=tmin

            if t2<t0 and t2<t1 and t2<t3:
                ca+=c
                b=binomial(n,pr(ca,cb,taup))
                n-=b
                blist.append(b)
                apcount+=1

                tmin=t2
                timer-=tmin
                aptimer=aptimerinit
                prelist.append(tcurr+tmin)

            else:
                tmin=t3
                timer=delta_t
                aptimer-=tmin
                nlist.append(n)
                nulist.append(nu)
                tlist.append(tcurr)
                calist.append(ca)

            tcurr+=tmin

            ca+=-(ca-cb)/tauc*tmin

        bavs.append(blist)

    minlen=np.min([len(x) for x in bavs])
    bavs=np.array([x[:minlen] for x in bavs])

    return tlist,nlist,nulist,np.mean(bavs,axis=0),prelist,calist,bavs

def pr(ca,cb,taup):
    pmax=0.2
    pmin=0.01
    return pmax-(pmax-pmin)*np.exp(-(ca-cb)/taup)

