                n1+=binomial(M1-n1, p1d(i,prefill1,prefillmin,thr,hill))
                n2+=binomial(M2-n2, p2d(i,prefill2))
                n3+=binomial(M3-n3, p3d(i,prefill3,prefillmin3,thr3,hill3))
            b1=binomial(n1,pr1)
            b2=binomial(n2,pr2)
            b3=binomial(n3,pr3)
            n1-=b1
            n2-=b2
            n3-=b3
            b=b1+b2+b3
            blist.append(b)
        bmeanlist.append(blist)
    minlen=np.min([len(b) for b in bmeanlist])
    bmeanlist2=np.array([x[:minlen] for x in bmeanlist])
    ff=np.var(bmeanlist2, axis=0)/np.mean(bmeanlist2, axis=0)
    bmean=np.mean(bmeanlist2, axis=0)
    return bmean,ff

def model(pr1,pr2,pr3,M2,M3,hill,hill3,thr,thr3,prefill1,prefill2,prefill3,prefillmin,prefillmin3):
    p1i = np.ones(nstim)
    p2i = np.ones(nstim)
    p3i = np.ones(nstim)
    M1 = int(round(mean_data[0]/pr1 - M2 - M3))
    for i in range(1,nstim):
        p1i[i] = p1i[i-1]*(1-pr1)+(1-p1i[i-1]*(1-pr1))*p1d(i-1,prefill1,prefillmin,thr,hill)
        p2i[i] = p2i[i-1]*(1-pr2)+(1-p2i[i-1]*(1-pr2))*p2d(i-1,prefill2)
        p3i[i] = p3i[i-1]*(1-pr3)+(1-p3i[i-1]*(1-pr3))*p3d(i-1,prefill3,prefillmin3,thr3,hill3)
    
    mqc1=M1*p1i*pr1
    mqc2=M2*p2i*pr2
    mqc3=M3*p3i*pr3
    mqc=mqc1+mqc2+mqc3
    vqc = (M1*p1i*pr1*(1-p1i*pr1)+
           M2*p2i*pr2*(1-p2i*pr2)+
           M3*p3i*pr3*(1-p3i*pr3))
    vei = mqc*CVq**2+vqc
    CV2ei = vei/(mqc**2)
    FF = vei/mqc
    return mqc,CV2ei,FF,mqc1,mqc2,mqc3

def get_model(params):
    if ttype==3:
        pr1,pr2,pr3,M2,M3,hill,hill3,thr,thr3,prefill1,prefill2,prefill3,prefillmin,prefillmin3= params
    if ttype==2:
        pr1,pr2,M2,hill,hill3,thr,thr3,prefill1,prefill2,prefill3,prefillmin,prefillmin3= params
        M3=0
        pr3=0
    if ttype==1:
        pr1,hill,hill3,thr,thr3,prefill1,prefill2,prefill3,prefillmin,prefillmin3= params
        M2=M3=0
        pr2=pr3=0

    M2 = int(round(M2))
    M3 = int(round(M3))
    # pr2=pr1
    # pr3=pr1
    M1 = int(round(mean_data[0]/pr1 - M2 - M3))
    if M1 <= 0:
        return None,None,None, None, None, None
    mqc, CV2ei, FF, mqc1, mqc2, mqc3 = model(pr1,pr2,pr3,M2,M3,hill,hill3,thr,thr3,prefill1,prefill2,prefill3,prefillmin,prefillmin3)
    return mqc, CV2ei, FF, mqc1, mqc2, mqc3

def mle(params):
    params = np.array(params)
    params[1] = round(params[1])
    params[2] = round(params[2])
    mqc,CV2,FF, mqc1, mqc2, mqc3 = get_model(params)
    if mqc is None:
        return np.inf
    if np.any(mqc<=0) or np.any(CV2<=0):
        return np.inf
    shape = 1/CV2
    scale = mqc*CV2
    if np.any(shape<=0) or np.any(scale<=0):
        return np.inf
    loglik = gamma.logpdf(obs,a=shape[:,None],scale=scale[:,None])
    if np.any(~np.isfinite(loglik)):
        return np.inf
    return -np.sum(loglik)

